{
  "name": "LumynLabs-cx",
  "version": "4.4.0",
  "description": "Lumyn Labs SDK for ConnectorX",
  "keywords": [
    "connectorx",
    "led",
    "animation",
    "robotics",
    "frc",
    "rp2040"
  ],
  "authors": [
    {
      "name": "Lumyn Labs",
      "url": "https://lumynlabs.com"
    }
  ],
  "license": "UNLICENSED",
  "frameworks": [
    "arduino"
  ],
  "platforms": [
    "raspberrypi"
  ],
  "build": {
    "flags": [
      "-I include",
      "-I include/FastLED"
    ],
    "libArchive": false,
    "extraScript": "link_sdk.py"
  },
  "dependencies": {
    "FreeRTOS": "*",
    "LittleFS": "*",
    "SDFS": "*",
    "SPI": "*",
    "Wire": "*",
    "EEPROM": "*",
    "bblanchon/ArduinoJson": "7.4.3",
    "Adafruit TinyUSB Library": "*"
  },
  "export": {
    "include": [
      "include/*",
      "lib/*"
    ],
    "exclude": [
      "src/*",
      ".pio/*"
    ]
  }
}
